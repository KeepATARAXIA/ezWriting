{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ezwriting-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-13",
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/auth/*", "/sync/*", "/health"]
  }
}
