{
  "name": "ezwriting",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first multi-platform content publishing workbench.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KeepATARAXIA/ezWriting.git"
  },
  "bugs": {
    "url": "https://github.com/KeepATARAXIA/ezWriting/issues"
  },
  "homepage": "https://ezwriting.online/",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b && tsc -p cloudflare/worker/tsconfig.json",
    "verify": "npm test && npm run build",
    "worker:dev": "wrangler dev --config cloudflare/worker/wrangler.jsonc",
    "worker:deploy": "npm run verify && wrangler deploy --config cloudflare/worker/wrangler.jsonc"
  },
  "dependencies": {
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.8",
    "@tiptap/extension-highlight": "3.30.0",
    "@tiptap/extension-image": "3.30.0",
    "@tiptap/extension-placeholder": "3.30.0",
    "@tiptap/extension-table": "3.30.0",
    "@tiptap/extension-text-style": "3.30.0",
    "@tiptap/pm": "3.30.0",
    "@tiptap/react": "3.30.0",
    "@tiptap/starter-kit": "3.30.0",
    "codemirror": "^6.0.1",
    "dompurify": "3.4.13",
    "jszip": "3.10.1",
    "lucide-react": "1.31.0",
    "marked": "18.0.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260813.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wrangler": "4.122.0"
  }
}
